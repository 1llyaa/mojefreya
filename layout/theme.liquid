<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Font preloading. The typefaces are self-hosted in assets/, so there is no
      third-party font CDN to preconnect to. Only the latin subsets are
      preloaded: latin-ext carries the Czech diacritics but is a fraction of the
      glyphs, so the browser fetches it off the @font-face unicode-range instead
      of blocking the initial render on it.
    {% endcomment %}
    {{ 'instrument-serif-latin.woff2' | asset_url | preload_tag: as: 'font' }}
    {{ 'instrument-sans-latin.woff2' | asset_url | preload_tag: as: 'font' }}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% sections 'footer-group' %}

    {% comment %} Cosmetic overrides for Shopify's native consent banner {% endcomment %}
    {% render 'consent-banner-styles' %}
  </body>
</html>
