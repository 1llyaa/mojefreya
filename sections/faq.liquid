<div class="band faq full-width">
  <div class="band__inner">
    <h2 class="faq__heading">{{ section.settings.heading }}</h2>
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .faq {
    padding-block: 32px;
  }

  .faq__heading {
    margin: 0 0 8px;
  }

  @media (min-width: 750px) {
    .faq {
      padding-block: 56px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.faq",
  "blocks": [{ "type": "faq-item" }],
  "settings": [
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Časté dotazy" }
  ],
  "presets": [
    {
      "name": "t:general.faq",
      "blocks": [
        { "type": "faq-item", "settings": { "question": "Bolí to?", "answer": "<p>Většina lidí cítí jen teplo nebo lehké štípnutí. Začněte na nejnižší z 5 úrovní intenzity a postupně přidávejte.</p>", "open_by_default": true } },
        { "type": "faq-item", "settings": { "question": "Funguje na každou pokožku a chloupky?", "answer": "<p>Nejlépe funguje na světlé až středně tmavé pokožce s tmavšími chloupky. Na velmi světlé, šedé a zrzavé chloupky je účinnost nižší.</p>", "open_by_default": true } },
        { "type": "faq-item", "settings": { "question": "Kdy uvidím výsledky?", "answer": "<p>Chloupků začne viditelně ubývat obvykle po 2–4 ošetřeních. Výsledky se liší podle typu pokožky a chloupků.</p>" } },
        { "type": "faq-item", "settings": { "question": "Je výsledek trvalý?", "answer": "<p>Efekt je dlouhodobý, ne trvalý. Pro udržení hladké pokožky ošetření zopakujte přibližně každých 6 týdnů.</p>" } },
        { "type": "faq-item", "settings": { "question": "Musím se před ošetřením oholit?", "answer": "<p>Ano, pokožku před každým ošetřením oholte, světlo se tak lépe dostane ke kořínkům. Mezi ošetřeními se holit můžete.</p>" } },
        { "type": "faq-item", "settings": { "question": "Na které části těla ho můžu použít?", "answer": "<p>Na nohy, ruce, podpaží, linii bikin i obličej. Nepoužívejte ho v okolí očí.</p>" } },
        { "type": "faq-item", "settings": { "question": "Je to bezpečné? Kdy přístroj nepoužívat?", "answer": "<p>Při použití podle návodu ano. Nepoužívejte ho v těhotenství a při kojení, na tetování (držte odstup 1–2 cm), na znaménka a na podrážděnou nebo čerstvě opálenou pokožku. Při ošetření mějte nasazené ochranné brýle z balení.</p>" } },
        { "type": "faq-item", "settings": { "question": "Je vhodný i pro muže?", "answer": "<p>Ano, funguje stejně. Není určený na husté vousy na obličeji.</p>" } },
        { "type": "faq-item", "settings": { "question": "Funguje bez kabelu?", "answer": "<p>Ne, přístroj je napájený ze sítě a při ošetření musí být zapojený.</p>" } },
        { "type": "faq-item", "settings": { "question": "Co je v balení?", "answer": "<p>Epilátor, ochranné brýle, holicí strojek, adaptér a návod v češtině.</p>" } },
        { "type": "faq-item", "settings": { "question": "Jak dlouho přístroj vydrží?", "answer": "<p>Lampa vydrží přibližně 300 000 záblesků, což při běžném domácím používání stačí na řadu let.</p>" } },
        { "type": "faq-item", "settings": { "question": "Kolik stojí doprava a jak dlouho trvá?", "answer": "<p>Doručujeme na výdejní místo nebo do boxu Zásilkovny a do AlzaBoxu za 69 Kč. Zásilka dorazí obvykle do 3 pracovních dnů.</p>" } },
        { "type": "faq-item", "settings": { "question": "Jak můžu zaplatit?", "answer": "<p>Platební kartou, přes Apple Pay nebo Google Pay, nebo na dobírku při převzetí. Dobírka stojí 40 Kč navíc.</p>" } },
        { "type": "faq-item", "settings": { "question": "Jak funguje vrácení do 60 dnů?", "answer": "<p>Přístroj můžete do 60 dnů od převzetí vrátit, i když jste ho vyzkoušela. Pošlete ho kompletní a nepoškozený v původním balení, poštovné zpět hradíte vy. Peníze vrátíme do 14 dnů od doručení.</p>" } },
        { "type": "faq-item", "settings": { "question": "Jaká je záruka?", "answer": "<p>Na přístroj se vztahuje zákonná záruka 24 měsíců.</p>" } }
      ]
    }
  ]
}
{% endschema %}
