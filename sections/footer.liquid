<div class="band band--inverse site-footer full-width">
  <div class="band__inner site-footer__inner">
    {% liquid
      assign has_policy_links = false
      if section.settings.show_policies
        if shop.policies.size > 0
          assign has_policy_links = true
        endif
      endif

      assign has_menu = false
      if section.settings.menu.links.size > 0
        assign has_menu = true
      endif
    %}

    {% if has_policy_links or has_menu %}
      <nav class="site-footer__links" aria-label="{{ 'footer.legal' | t }}">
        {% if has_policy_links %}
          {% comment %}
            Fixed order and Czech names, independent of the titles Shopify
            generates for each policy, matched on the policy's URL handle.
          {% endcomment %}
          {% assign policy_handles = 'terms-of-service,refund-policy,privacy-policy,shipping-policy,contact-information' | split: ',' %}
          {% for handle in policy_handles %}
            {% assign policy_path = '/policies/' | append: handle %}
            {% for policy in shop.policies %}
              {% if policy.url contains policy_path %}
                {% case handle %}
                  {% when 'terms-of-service' %}
                    {% assign policy_label = 'footer.terms' | t %}
                  {% when 'refund-policy' %}
                    {% assign policy_label = 'footer.refund' | t %}
                  {% when 'privacy-policy' %}
                    {% assign policy_label = 'footer.privacy' | t %}
                  {% when 'shipping-policy' %}
                    {% assign policy_label = 'footer.shipping' | t %}
                  {% else %}
                    {% assign policy_label = 'footer.contact' | t %}
                {% endcase %}
                <a class="site-footer__link" href="{{ policy.url }}">{{ policy_label }}</a>
              {% endif %}
            {% endfor %}
          {% endfor %}
        {% endif %}

        {% if has_menu %}
          {% for link in section.settings.menu.links %}
            <a class="site-footer__link" href="{{ link.url }}">{{ link.title }}</a>
          {% endfor %}
        {% endif %}
      </nav>
    {% endif %}

    {% if section.settings.operator != blank %}
      <div class="site-footer__operator">
        <p>{{ section.settings.operator }}</p>
        <p>{% render 'support-contact' %}</p>
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .site-footer {
    padding-block: 32px;
    font-size: var(--font-size-micro);
  }

  .site-footer__inner {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .site-footer__links {
    display: flex;
    flex-direction: column;
  }

  .site-footer__link {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    min-height: 44px;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .site-footer__operator {
    margin: 8px 0 0;
    padding-block-start: 16px;
    border-block-start: 1px solid color-mix(in srgb, currentcolor 14%, transparent);
    color: color-mix(in srgb, currentcolor 72%, transparent);
    line-height: 1.6;
  }

  .site-footer__operator > p {
    margin: 0;
  }

  .site-footer__operator .support-contact__link {
    color: inherit;
  }

  @media (min-width: 750px) {
    .site-footer {
      padding-block: 48px;
    }

    .site-footer__links {
      flex-direction: row;
      flex-wrap: wrap;
      column-gap: 24px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    { "type": "checkbox", "id": "show_policies", "label": "t:labels.show_policies", "info": "t:info.show_policies", "default": true },
    { "type": "link_list", "id": "menu", "label": "t:labels.menu", "info": "t:info.footer_menu" },
    { "type": "text", "id": "operator", "label": "t:labels.operator", "info": "t:info.operator", "default": "Provozovatel: Delina Czechia s.r.o., IČO 11792094, Vítkova 188/22, 186 00 Praha 8" }
  ]
}
{% endschema %}
