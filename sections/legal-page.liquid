<div class="legal">
  <h1 class="legal__title">{{ page.title }}</h1>

  {% if section.settings.effective_from != blank %}
    <p class="legal__meta">{{ section.settings.effective_from }}</p>
  {% endif %}

  {% if section.settings.notice != blank %}
    <div class="legal__notice">{{ section.settings.notice }}</div>
  {% endif %}

  <div class="legal__body rte">{{ page.content }}</div>
</div>

{% stylesheet %}
  .legal {
    max-width: var(--measure);
    margin-inline: auto;
    padding-block: 32px 40px;
  }

  .legal__title {
    margin: 0 0 8px;
  }

  .legal__meta {
    margin: 0 0 24px;
    color: var(--color-text-secondary);
    font-size: var(--font-size-micro);
  }

  .legal__notice {
    margin-block-end: 24px;
    padding: 16px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background-color: var(--color-surface-alt);
    font-size: var(--font-size-micro);
    line-height: 1.55;
  }

  .legal__notice > p {
    margin: 0;
  }

  .legal__body {
    line-height: 1.6;
  }

  .legal__body :is(h2, h3) {
    margin-block: 32px 8px;
  }

  .legal__body :is(p, ul, ol) {
    margin-block: 0 12px;
    color: var(--color-text-secondary);
  }

  .legal__body :is(ul, ol) {
    padding-inline-start: 20px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.legal_page",
  "settings": [
    { "type": "text", "id": "effective_from", "label": "t:labels.effective_from", "default": "Účinné od [datum] · verze 1.0" },
    { "type": "richtext", "id": "notice", "label": "t:labels.notice", "info": "t:info.legal_notice" }
  ],
  "presets": [{ "name": "t:general.legal_page" }]
}
{% endschema %}
