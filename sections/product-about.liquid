<div class="band band--surface about full-width">
  <div class="band__inner">
    <h2 class="about__heading">{{ section.settings.heading }}</h2>
    <div class="about__body">{{ section.settings.body }}</div>
  </div>
</div>

{% stylesheet %}
  .about {
    padding-block: 32px 24px;
  }

  .about__heading {
    margin: 0 0 12px;
  }

  .about__body {
    max-width: var(--measure);
    color: var(--color-text-secondary);
    line-height: 1.55;
  }

  @media (min-width: 750px) {
    .about {
      padding-block: 56px 40px;
    }
  }

  .about__body > p {
    margin-block: 0 12px;
  }

  .about__body > p:last-child {
    margin-block-end: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.about",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "O produktu" },
    {
      "type": "richtext",
      "id": "body",
      "label": "t:labels.body",
      "default": "<p>IPL vysílá krátké pulzy světla, které pohltí melanin v chloupku a zpomalí jeho růst. Nejlépe funguje na kontrastu světlá pokožka + tmavší chloupek.</p><p>V balení: epilátor, ochranné brýle, žiletka, adaptér, návod v češtině.</p>"
    }
  ],
  "presets": [{ "name": "t:general.about" }]
}
{% endschema %}
