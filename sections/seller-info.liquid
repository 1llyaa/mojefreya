<div class="band band--surface seller-info full-width">
  <div class="band__inner seller-info__inner">
    {% if section.settings.heading != blank %}
      <h2 class="seller-info__heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <ul class="seller-info__list" role="list">
      <li class="seller-info__item">{{ 'seller.czech_seller' | t }}</li>
      <li class="seller-info__item">{{ 'seller.warranty' | t }}</li>
      <li class="seller-info__item">
        {{ 'seller.support' | t: hours: settings.support_hours }}:
        {% render 'support-contact', separator: ', ' %}
      </li>
    </ul>
  </div>
</div>

{% stylesheet %}
  .seller-info {
    padding-block: 32px;
  }

  .seller-info__heading {
    margin: 0 0 12px;
  }

  .seller-info__list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--color-text-secondary);
  }

  .seller-info__item .support-contact__link {
    color: var(--color-foreground);
    text-underline-offset: 3px;
  }

  @media (min-width: 750px) {
    .seller-info {
      padding-block: 48px;
    }

    .seller-info__list {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 8px 32px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.seller_info",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Kdo jsme" }
  ],
  "presets": [{ "name": "t:general.seller_info" }]
}
{% endschema %}
