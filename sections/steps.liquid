<div class="band band--surface-alt steps full-width">
  <div class="band__inner">
    <h2 class="steps__heading">{{ section.settings.heading }}</h2>
    <div class="steps__items">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .steps {
    padding-block: 32px;
  }

  .steps__heading {
    margin: 0 0 24px;
  }

  .steps__items {
    display: grid;
    gap: 24px;
    counter-reset: step;
  }

  @media (min-width: 750px) {
    .steps {
      padding-block: 56px;
    }

    .steps__items {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 32px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.steps",
  "blocks": [{ "type": "step" }],
  "settings": [
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Jak to funguje" }
  ],
  "presets": [
    {
      "name": "t:general.steps",
      "blocks": [
        { "type": "step", "settings": { "title": "Oholit", "body": "Pokožku před aplikací oholte, světlo se lépe dostane ke kořínkům." } },
        { "type": "step", "settings": { "title": "Nastavit a přiložit", "body": "Nastavte intenzitu, přiložte kolmo k pokožce, aktivujte záblesk." } },
        { "type": "step", "settings": { "title": "Posouvat", "body": "Posouvejte po dalších částech pokožky a opakujte." } }
      ]
    }
  ]
}
{% endschema %}
