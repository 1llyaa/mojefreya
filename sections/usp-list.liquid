<div class="band band--surface usp-list full-width">
  <div class="band__inner">
    <h2 class="usp-list__heading">{{ section.settings.heading }}</h2>
    <div class="usp-list__items">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% stylesheet %}
  .usp-list {
    padding-block: 32px 24px;
  }

  .usp-list__heading {
    margin: 0 0 16px;
  }

  .usp-list__items {
    display: grid;
    gap: 12px;
  }

  @media (min-width: 750px) {
    .usp-list {
      padding-block: 56px 48px;
    }

    .usp-list__items {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.usp_list",
  "blocks": [{ "type": "usp-card" }],
  "settings": [
    { "type": "text", "id": "heading", "label": "t:labels.heading", "default": "Proč IPL epilátor" }
  ],
  "presets": [
    {
      "name": "t:general.usp_list",
      "blocks": [
        { "type": "usp-card", "settings": { "title": "Dostupnější než laser studio", "body": "Zaplatí se během jedné sezóny — místo opakovaných návštěv.", "highlighted": true } },
        { "type": "usp-card", "settings": { "title": "Rychlé výsledky", "body": "Znatelný pokles ochlupení po 1–3 aplikacích." } },
        { "type": "usp-card", "settings": { "title": "Bezbolestné a bezpečné", "body": "Šetrné k pokožce, vhodné i pro citlivé partie." } },
        { "type": "usp-card", "settings": { "title": "Použitelné téměř všude", "body": "Nohy, podpaží, bikiny, obličej." } }
      ]
    }
  ]
}
{% endschema %}
