{% doc %}
  Emits the theme's design tokens as CSS custom properties on `:root`, plus the
  `@font-face` declarations for the two self-hosted brand typefaces.

  Rendered first in the `<head>` of every layout, before `critical.css`, so the
  tokens exist before any rule consumes them.

  The typefaces are self-hosted rather than loaded from a `font_picker`:
  Shopify's font library carries neither Instrument Serif nor Instrument Sans,
  and hotlinking Google Fonts would leak visitor IPs to a third party.

  @example
  {% render 'css-variables' %}
{% enddoc %}

{% style %}
  {% # Instrument Serif — display. 400 only, latin + latin-ext (Czech diacritics). %}
  @font-face {
    font-family: 'Instrument Serif';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('{{ 'instrument-serif-latin-ext.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }
  @font-face {
    font-family: 'Instrument Serif';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('{{ 'instrument-serif-latin.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  {% # Instrument Sans — everything functional. Variable 400–700, one file per subset. %}
  @font-face {
    font-family: 'Instrument Sans';
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
    src: url('{{ 'instrument-sans-latin-ext.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }
  @font-face {
    font-family: 'Instrument Sans';
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
    src: url('{{ 'instrument-sans-latin.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  :root {
    {% # Typefaces %}
    --font-display--family: 'Instrument Serif', Georgia, 'Times New Roman', serif;
    --font-body--family: 'Instrument Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;

    {% # Type scale — 14 / 16 / 20 / 24 / 32, nothing between %}
    --font-size-micro: 0.875rem;
    --font-size-body: 1rem;
    --font-size-lead: 1.25rem;
    --font-size-h2: 1.5rem;
    --font-size-h1: 2rem;

    --line-height-h1: 1.14;
    --line-height-h2: 1.2;
    --line-height-body: 1.5;
    --line-height-price: 1.2;

    {% # Layout %}
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;

    {% comment %}
      The design is a 390px mobile artboard. On wide screens the page width
      alone is not enough: prose needs a reading measure, and the layout needs a
      container narrower than the full 90rem or lines run past 1400px.
    {% endcomment %}
    --layout-max: min(var(--page-width), 64rem);
    --measure: min(var(--page-width), 40rem);

    {% # Palette — 60 / 30 / 10 %}
    --color-background: {{ settings.background_color }};
    --color-surface: {{ settings.color_surface }};
    --color-surface-alt: {{ settings.color_surface_alt }};
    --color-foreground: {{ settings.foreground_color }};
    --color-text-secondary: {{ settings.color_text_secondary }};
    --color-accent: {{ settings.color_accent }};
    --color-on-accent: {{ settings.color_on_accent }};
    {% # Warm neutrals, derived so they track the palette instead of drifting from it %}
    --color-border: color-mix(in srgb, {{ settings.color_surface_alt }} 96%, {{ settings.foreground_color }});
    --color-on-inverse: color-mix(in srgb, {{ settings.color_surface_alt }} 94%, {{ settings.foreground_color }});
    --color-text-muted: color-mix(in srgb, {{ settings.color_text_secondary }} 90%, {{ settings.background_color }});

    {% # Controls — measured off artboard 3a %}
    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;
    --button-min-height: 48px;
    --button-radius: 8px;

    {% # Elevation — level 1 on the CTA, level 2 on the sticky bar (casts upward) %}
    --elevation-1: 0 1px 2px rgb(46 42 39 / 14%);
    --elevation-2: 0 -1px 2px rgb(46 42 39 / 6%), 0 -4px 16px rgb(46 42 39 / 12%);

    {% # Consumed by the inlined SVGs in assets/icon-*.svg %}
    --icon-stroke-width: 1.5;
  }
{% endstyle %}
