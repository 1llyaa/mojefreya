{% doc %}
  Renders a square, swipeable product gallery. On mobile the next photo peeks
  in from the edge and position dots sit below; on desktop 64px thumbnails
  replace the dots.

  Scrolling is native CSS scroll-snap, so swipe, trackpad and keyboard all work
  before any JavaScript runs. The script only keeps the dots in sync and makes
  them clickable; without it the gallery still scrolls, it just cannot jump.

  Falls back to a single static image when the product has only one, and renders
  nothing when it has none.

  @param {object} product - The product whose images are shown

  @example
  {% render 'product-gallery', product: product %}
{% enddoc %}

{% liquid
  assign images = product.images
  assign image_count = images | size
%}

{% if image_count > 0 %}
  <product-gallery
    class="gallery"
    {% if image_count > 1 %}data-multiple{% endif %}
  >
    <div
      class="gallery__track"
      role="region"
      aria-label="{{ 'gallery.label' | t }}"
      tabindex="0"
    >
      {% for image in images %}
        <div class="gallery__slide" data-index="{{ forloop.index0 }}">
          {%- liquid
            assign alt = image.alt | default: product.title
            assign loading = 'lazy'
            assign priority = 'auto'
            if forloop.first
              assign loading = 'eager'
              assign priority = 'high'
            endif
          -%}
          {{
            image
            | image_url: width: 1200
            | image_tag:
              class: 'gallery__image',
              alt: alt,
              widths: '390, 585, 780, 1000, 1200',
              sizes: '(min-width: 750px) 50vw, 100vw',
              loading: loading,
              fetchpriority: priority
          }}
        </div>
      {% endfor %}
    </div>

    {% if image_count > 1 %}
      <div class="gallery__dots" role="tablist" aria-label="{{ 'gallery.choose' | t }}">
        {% for image in images %}
          <button
            class="gallery__dot"
            type="button"
            role="tab"
            data-index="{{ forloop.index0 }}"
            aria-label="{{ 'gallery.go_to' | t: index: forloop.index }}"
            {% if forloop.first %}
              aria-selected="true"
            {% else %}
              aria-selected="false"
            {% endif %}
          ></button>
        {% endfor %}
      </div>

      <div class="gallery__thumbs" role="tablist" aria-label="{{ 'gallery.choose' | t }}">
        {% for image in images %}
          <button
            class="gallery__thumb"
            type="button"
            role="tab"
            data-index="{{ forloop.index0 }}"
            aria-label="{{ 'gallery.go_to' | t: index: forloop.index }}"
            {% if forloop.first %}
              aria-selected="true"
            {% else %}
              aria-selected="false"
            {% endif %}
          >
            {{ image | image_url: width: 128, height: 128, crop: 'center' | image_tag: alt: '', class: 'gallery__thumb-image', loading: 'lazy', width: 64, height: 64 }}
          </button>
        {% endfor %}
      </div>
    {% endif %}
  </product-gallery>
{% endif %}

{% stylesheet %}
  .gallery {
    position: relative;
    display: block;
  }

  .gallery__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .gallery__track::-webkit-scrollbar {
    display: none;
  }

  .gallery__track:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: -2px;
  }

  .gallery__slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    border-radius: 8px;
    overflow: hidden;
    background-color: var(--color-surface-alt);
  }

  /* Let the next photo peek in so the gallery reads as swipeable. */
  .gallery[data-multiple] .gallery__track {
    gap: 8px;
  }

  .gallery[data-multiple] .gallery__slide {
    flex-basis: 88%;
  }

  .gallery__image {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
  }

  .gallery__dots {
    position: absolute;
    inset-block-end: 8px;
    inset-inline: 0;
    display: flex;
    width: fit-content;
    margin-inline: auto;
    padding: 0 4px;
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--color-background) 72%, transparent);
    backdrop-filter: blur(6px);
  }

  /* The button is the 24px hit area; the visible dot is drawn inside it. */
  .gallery__dot {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
  }

  .gallery__dot::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #807c78;
    transition: background-color 150ms ease-out, transform 150ms ease-out;
  }

  .gallery__dot[aria-selected="true"]::before {
    background-color: var(--color-foreground);
    transform: scale(1.25);
  }

  .gallery__dot:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: -2px;
    border-radius: 50%;
  }

  .gallery__thumbs {
    display: none;
  }

  @media (min-width: 750px) {
    .gallery[data-multiple] .gallery__track {
      gap: 0;
    }

    .gallery[data-multiple] .gallery__slide {
      flex-basis: 100%;
    }

    .gallery__dots {
      display: none;
    }

    .gallery__thumbs {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-block-start: 12px;
    }

    .gallery__thumb {
      width: 64px;
      height: 64px;
      padding: 0;
      border: 1px solid var(--color-border);
      border-radius: 6px;
      overflow: hidden;
      background-color: var(--color-surface-alt);
      cursor: pointer;
      opacity: 0.7;
      transition: opacity 150ms ease-out, border-color 150ms ease-out;
    }

    .gallery__thumb[aria-selected="true"] {
      border-color: var(--color-foreground);
      opacity: 1;
    }

    .gallery__thumb:focus-visible {
      outline: 2px solid var(--color-foreground);
      outline-offset: 2px;
    }

    .gallery__thumb-image {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery__dot::before,
    .gallery__thumb {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  class ProductGallery extends HTMLElement {
    connectedCallback() {
      this.track = this.querySelector('.gallery__track');
      this.dots = Array.from(this.querySelectorAll('.gallery__dot, .gallery__thumb'));
      if (!this.track || this.dots.length === 0) return;

      this.slides = Array.from(this.querySelectorAll('.gallery__slide'));

      this.dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const slide = this.slides[Number(dot.dataset.index)];
          if (!slide) return;
          this.track.scrollTo({
            left: slide.offsetLeft - this.track.offsetLeft,
            behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches
              ? 'auto'
              : 'smooth',
          });
        });
      });

      this.observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            this.select(Number(entry.target.dataset.index));
          });
        },
        { root: this.track, threshold: 0.6 }
      );

      this.slides.forEach((slide) => this.observer.observe(slide));
    }

    disconnectedCallback() {
      this.observer?.disconnect();
    }

    select(index) {
      this.dots.forEach((dot) => {
        dot.setAttribute('aria-selected', String(Number(dot.dataset.index) === index));
      });
    }
  }

  if (!customElements.get('product-gallery')) {
    customElements.define('product-gallery', ProductGallery);
  }
{% endjavascript %}
