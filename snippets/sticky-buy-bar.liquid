{% doc %}
  Renders the fixed bottom purchase bar: current price, compare-at price and a
  submit button wired to the fold's product form.

  The button sits outside that form and reaches it through the HTML `form`
  attribute, so the page carries one product form rather than two.

  The bar stays hidden while any element marked `data-buy-anchor` (the fold
  button, the buy block under the FAQ) is on screen, so the page never shows
  two identical buy buttons at once.

  @param {string} form_id - The id of the product form this button submits
  @param {object} variant - The variant whose price and availability are shown

  @example
  {% render 'sticky-buy-bar', form_id: 'fold-buy', variant: product.selected_or_first_available_variant %}
{% enddoc %}

<div class="sticky-buy is-hidden" data-sticky-buy>
  <div class="sticky-buy__inner">
    <div class="sticky-buy__price">
      <span class="sticky-buy__price-current">
        <span class="visually-hidden">{{ 'product.price_current' | t }}</span>
        {% render 'format-price', amount: variant.price %}
      </span>
      {% if variant.compare_at_price > variant.price %}
        <s class="sticky-buy__price-compare">
          <span class="visually-hidden">{{ 'product.price_compare' | t }}</span>
          {% render 'format-price', amount: variant.compare_at_price %}
        </s>
      {% endif %}
    </div>

    <button
      type="submit"
      form="{{ form_id }}"
      class="button button--accent sticky-buy__cta"
      {% unless variant.available %}disabled{% endunless %}
    >
      {% if variant.available %}
        {{ 'product.buy' | t }}
      {% else %}
        {{ 'product.sold_out' | t }}
      {% endif %}
    </button>
  </div>
</div>

{% stylesheet %}
  .sticky-buy {
    position: fixed;
    inset-block-end: 0;
    inset-inline: 0;
    z-index: 20;
    box-sizing: border-box;
    padding: 10px var(--page-margin);
    padding-block-end: max(10px, env(safe-area-inset-bottom));
    background-color: var(--color-background);
    box-shadow: var(--elevation-2);
    transition: transform 0.25s ease, visibility 0.25s;
  }

  .sticky-buy.is-hidden {
    visibility: hidden;
    transform: translateY(100%);
  }

  .sticky-buy__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    max-width: var(--layout-max);
    margin-inline: auto;
  }

  .sticky-buy__price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
  }

  .sticky-buy__price-current {
    font-size: var(--font-size-lead);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .sticky-buy__price-compare {
    color: var(--color-text-muted);
    font-size: var(--font-size-micro);
  }

  .sticky-buy__cta {
    flex: 1;
    max-width: 60%;
    font-size: var(--font-size-body);
  }

  @media (min-width: 750px) {
    .sticky-buy__cta {
      flex: none;
      min-width: 240px;
    }
  }

  .sticky-buy__cta[disabled] {
    background-color: var(--color-text-muted);
    cursor: not-allowed;
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const bar = document.querySelector('[data-sticky-buy]');
    const anchors = document.querySelectorAll('[data-buy-anchor]');
    if (!bar) return;

    if (anchors.length === 0 || !('IntersectionObserver' in window)) {
      bar.classList.remove('is-hidden');
      return;
    }

    const visible = new Set();

    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          visible.add(entry.target);
        } else {
          visible.delete(entry.target);
        }
      }
      bar.classList.toggle('is-hidden', visible.size > 0);
    });

    anchors.forEach((anchor) => observer.observe(anchor));
  })();
{% endjavascript %}
