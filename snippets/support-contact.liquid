{% doc %}
  Renders the support e-mail and phone as links, from Theme settings ›
  Commerce facts. There is deliberately no fallback to the store's account
  e-mail, which may be a private address.

  @param {string} [separator] - Text placed between e-mail and phone, default " · "

  @example
  {% render 'support-contact' %}
{% enddoc %}

{%- liquid
  assign support_email = settings.support_email | strip
  assign support_phone = settings.support_phone | strip
  assign phone_href = support_phone | remove: ' ' | prepend: 'tel:+420'
  assign sep = separator | default: ' · '
-%}
{%- if support_email != blank -%}
  <a class="support-contact__link" href="mailto:{{ support_email }}">{{ support_email }}</a>
{%- endif -%}
{%- if support_phone != blank -%}
  {%- if support_email != blank %}{{ sep }}{% endif -%}
  <a class="support-contact__link" href="{{ phone_href }}">{{ support_phone }}</a>
{%- endif -%}
